#!/usr/bin/env bash
set -euo pipefail

GL_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$GL_LIB/common.sh"

[ $# -ge 1 ] || { echo "usage: greenlyt <commande> [args]" >&2; exit 2; }
cmd=$1
shift

case "$cmd" in
  decide) file=verdict ;;
  commit-tour) file=commit_tour ;;
  *) file=$cmd ;;
esac

if [ ! -f "$GL_LIB/cmd_$file.sh" ]; then
  echo "greenlyt: commande inconnue : $cmd" >&2
  exit 2
fi

source "$GL_LIB/cmd_$file.sh"
"cmd_${cmd//-/_}" "$@"
