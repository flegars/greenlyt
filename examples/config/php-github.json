{
  "docsDir": "docs/greenlyt",
  "testCommand": "vendor/bin/phpunit",
  "maxAttempts": 5,
  "protectedBranches": [
    "main",
    "master",
    "develop"
  ],
  "branchPrefix": "feat/",
  "deviations": "ask",
